<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.infercat.host</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/infercat</string>
		<string>serve</string>
		<string>--data-dir</string>
		<string>/private/tmp/ic-data</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/max/Library/Logs/Infercat/host.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/max/Library/Logs/Infercat/host.log</string>
</dict>
</plist>
