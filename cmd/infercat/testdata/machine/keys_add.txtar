# Real CLI subprocess, fake local admin host; stdin/stdout are not terminals.
exit 0 infercat --data-dir $HOST keys add --json -- bob
! stderr .
cmpenv stdout success.json

# Usage errors remain one JSON object on stdout.
exit 2 infercat --data-dir $HOST keys add --json --unexpected -- bob
! stderr .
cmpenv stdout invalid.json

# Stopped-host semantics (including the offline exceptions).
exit 1 infercat --data-dir $NOHOST keys add --json -- bob
! stderr .
cmpenv stdout stopped.json

# Route failures keep their sentence and are never replayed.
cp failure.txt $HOST/failure
exit 1 infercat --data-dir $HOST keys add --json -- bob
! stderr .
cmpenv stdout error.json

-- failure.txt --
fail

-- success.json --
{"schema":1,"command":"keys.add","host":{"version":"$VERSION","name":"script host"},"data":{ "kept": [null, 0], "empty": [], "future": "<unchanged>" }}
-- invalid.json --
{"schema":1,"command":"keys.add","error":{"code":"invalid_arguments","message":"flag provided but not defined: -unexpected"}}
-- stopped.json --
{"schema":1,"command":"keys.add","error":{"code":"command_failed","message":"this host has no address yet — run infercat serve once first"}}
-- error.json --
{"schema":1,"command":"keys.add","error":{"code":"conflict","message":"fixture conflict"}}
