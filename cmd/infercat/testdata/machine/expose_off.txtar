# Real CLI subprocess, fake local admin host; stdin/stdout are not terminals.
exit 0 infercat --data-dir $HOST expose --off --json
! stderr .
cmpenv stdout success.json

# Usage errors remain one JSON object on stdout.
exit 2 infercat --data-dir $HOST expose --off --json --unexpected
! stderr .
cmpenv stdout invalid.json

# Stopped-host semantics (including the offline exceptions).
exit 69 infercat --data-dir $NOHOST expose --off --json
! stderr .
cmpenv stdout stopped.json

-- failure.txt --
fail

-- success.json --
{"schema":1,"command":"expose.off","host":{"version":"$VERSION","name":"script host"},"data":{"ok":true}}
-- invalid.json --
{"schema":1,"command":"expose","error":{"code":"invalid_arguments","message":"flag provided but not defined: -unexpected"}}
-- stopped.json --
{"schema":1,"command":"expose.off","error":{"code":"host_stopped","message":"no running host found for this data dir"}}
