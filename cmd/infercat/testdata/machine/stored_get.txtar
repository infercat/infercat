# Real CLI subprocess, fake local admin host; stdin/stdout are not terminals.
exit 0 infercat --data-dir $HOST stored k_a --json
! stderr .
cmpenv stdout success.json

# Usage errors remain one JSON object on stdout.
exit 2 infercat --data-dir $HOST stored k_a --json --unexpected
! stderr .
cmpenv stdout invalid.json

# Stopped-host semantics (including the offline exceptions).
exit 69 infercat --data-dir $NOHOST stored k_a --json
! stderr .
cmpenv stdout stopped.json

# Route failures keep their sentence and are never replayed.
cp failure.txt $HOST/failure
exit 1 infercat --data-dir $HOST stored k_a --json
! stderr .
cmpenv stdout error.json

-- failure.txt --
fail

-- success.json --
{"schema":1,"command":"stored.get","host":{"version":"$VERSION","name":"script host"},"data":{"cursor":"cursor-1","terminal":2,"clear_images":1,"retry_cleanup":0}}
-- invalid.json --
{"schema":1,"command":"stored.get","error":{"code":"invalid_arguments","message":"flag provided but not defined: -unexpected"}}
-- stopped.json --
{"schema":1,"command":"stored.get","error":{"code":"host_stopped","message":"no running host found for this data dir"}}
-- error.json --
{"schema":1,"command":"stored.get","error":{"code":"conflict","message":"fixture conflict"}}
