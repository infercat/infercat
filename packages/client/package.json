{
  "name": "@infercat/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An invite-bound fetch over the Infercat wasm tunnel.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/index.js && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "openai": "6.27.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "3.2.7"
  }
}
