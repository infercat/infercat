# Shared Swiss ink terminal frame. Requires the IBM Plex Mono font installed locally.
Set Shell bash
Set Width 1280
Set Height 720
Set FontFamily "IBM Plex Mono"
Set FontSize 18
Set Padding 24
Set Framerate 25
Set TypingSpeed 35ms
Set CursorBlink false
Set Theme {"name":"Swiss ink","background":"#FFFFFF","foreground":"#0A0A0A","black":"#0A0A0A","red":"#D5182F","green":"#0B7A4B","yellow":"#5C6068","blue":"#1F3BFF","magenta":"#1F3BFF","cyan":"#1F3BFF","white":"#FFFFFF","brightBlack":"#5C6068","brightRed":"#D5182F","brightGreen":"#0B7A4B","brightYellow":"#5C6068","brightBlue":"#1F3BFF","brightMagenta":"#1F3BFF","brightCyan":"#1F3BFF","brightWhite":"#FFFFFF","cursor":"#1F3BFF"}
